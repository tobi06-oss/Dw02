rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 운영자: 초대 코드를 만들고 회원을 볼 수 있다. 이메일이 아니라 로그인 계정 UID로 정한다 (Firebase 콘솔 > Authentication > 사용자 UID).
    // firebase-config.js의 OWNER_UIDS와 같은 값으로 맞춘다.
    function isOwner() {
      return request.auth != null && request.auth.uid in ['__OWNER_UID__'];
    }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    // 회원: 운영자이거나, 초대 코드로 등록했고 운영자가 이용을 멈추지(revoked) 않은 사람
    function isMember() {
      return request.auth != null
        && (isOwner() || (exists(memberPath(request.auth.uid))
                          && get(memberPath(request.auth.uid)).data.get('revoked', false) != true));
    }

    // 각자 자기 기록만 읽고 쓴다. 초대 코드로 등록한 회원만 (예전 트래커의 users/{uid}/... 기록도 그대로 동작)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && isMember();
    }
    // 종가: 회원은 읽기만, 쓰기는 GitHub Actions(서비스 계정)만
    match /prices/{ticker} {
      allow read: if isMember();
      allow write: if false;
    }

    // 초대 코드 {createdAt, note, max: 쓸 수 있는 인원, used: 쓴 인원}. 운영자만 만들고 보고 지운다.
    // 회원이 아닌 사람은 코드를 읽을 수 없고, 등록할 때(members 문서를 만드는 같은 일괄 쓰기 안에서) used를 1 올리는 것만 된다.
    // used가 max에 닿으면 더 이상 등록할 수 없다.
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    match /invites/{code} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['createdAt', 'note', 'max', 'used'])
        && request.resource.data.max is int && request.resource.data.max >= 1 && request.resource.data.max <= 50
        && request.resource.data.used == 0
        && code.matches('[A-HJ-NP-Z2-9]{10}');
      allow update: if request.auth != null
        && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == code
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.get('used', 0) + 1
        && request.resource.data.used <= resource.data.get('max', 1);
      allow delete: if isOwner();
    }

    // 회원 등록: 본인 문서만, 남은 자리가 있는 초대 코드로, 그 코드의 used를 같은 일괄 쓰기에서 1 올릴 때만.
    // email은 로그인 이메일 그대로, joinedAt은 서버 시각(serverTimestamp)만 된다.
    // 회원에서 빼기 = 운영자가 revoked: true로 바꾸기 (문서를 지우지 않으므로 같은 계정이 다른 코드로 다시 들어올 수 없다). 다시 들이기 = false
    match /members/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'email', 'joinedAt'])
        && request.resource.data.code is string
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.joinedAt == request.time
        && exists(invitePath(request.resource.data.code))
        && get(invitePath(request.resource.data.code)).data.get('used', 0) < get(invitePath(request.resource.data.code)).data.get('max', 1)
        && getAfter(invitePath(request.resource.data.code)).data.get('used', 0) == get(invitePath(request.resource.data.code)).data.get('used', 0) + 1;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked is bool;
      allow delete: if false;
    }
  }
}
