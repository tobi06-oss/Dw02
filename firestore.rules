rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 운영자: 초대 코드를 만들고 회원을 볼 수 있다. firebase-config.js의 OWNER_EMAILS와 같은 값으로 맞춘다.
    function isOwner() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in ['tobi06@daum.net'];
    }
    // 회원: 운영자이거나, 초대 코드로 등록한 사람 (members/{uid} 문서가 있음)
    function isMember() {
      return request.auth != null
        && (isOwner() || exists(/databases/$(database)/documents/members/$(request.auth.uid)));
    }

    // 각자 자기 기록만 읽고 쓴다. 초대 코드로 등록한 회원만 (예전 트래커의 users/{uid}/... 기록도 그대로 동작)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && isMember();
    }
    // 종가: 회원은 읽기만, 쓰기는 GitHub Actions(서비스 계정)만
    match /prices/{ticker} {
      allow read: if isMember();
      allow write: if false;
    }

    // 초대 코드: 운영자만 만들고 보고 지운다.
    // 회원이 아닌 사람은 코드를 읽을 수 없고, 등록할 때(members 문서를 만드는 같은 일괄 쓰기 안에서) 그 코드를 지우는 것만 된다 → 한 번 쓰면 끝
    match /invites/{code} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['createdAt', 'note'])
        && code.size() >= 8;
      allow delete: if isOwner()
        || (request.auth != null
            && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == code);
      allow update: if false;
    }

    // 회원 등록: 본인 문서만, 지금 있는 초대 코드로, 그 코드를 같은 일괄 쓰기에서 지울 때만
    match /members/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'email', 'joinedAt'])
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
        && !existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.code));
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
